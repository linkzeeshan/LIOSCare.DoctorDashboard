@model string
@{ ViewData["Title"] = "Reset Password"; }
<div class="lc-auth-simple">
    <div style="width:min(460px,calc(100% - 40px))">
        <div class="lc-brand" style="justify-content:center;margin-bottom:32px;">
            <img src="~/logo/LIO.jpeg" alt="LIOS Care" class="lc-logo" />
            <span><strong>LIOS Care</strong><small>Doctor workspace</small></span>
        </div>
        <div class="lc-login-card">
            <h2 style="margin:0 0 6px;">Choose a new password</h2>
            <p style="color:var(--lc-text-2);margin-bottom:20px;">Create a strong password for your doctor account.</p>
            @if (ViewData["Error"] is string err)
            {
                <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:10px;padding:10px 14px;margin-bottom:16px;color:#dc2626;font-size:14px;display:flex;gap:8px;align-items:center;">
                    <i class="bi bi-exclamation-circle"></i> @err
                </div>
            }
            <form method="post" onsubmit="this.querySelector('button[type=submit]').disabled=true;this.querySelector('button[type=submit]').textContent='Saving…'">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@Model" />
                <label>New password</label>
                <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" required
                       placeholder="Min 8 chars, upper, lower, digit" />
                <label style="margin-top:12px;">Confirm new password</label>
                <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required
                       placeholder="Repeat password" />
                <div style="background:var(--lc-primary-soft);border-radius:10px;padding:10px 14px;margin:14px 0;font-size:13px;color:var(--lc-text-2);">
                    <strong>Password requirements</strong>
                    <ul style="margin:6px 0 0 16px;padding:0;">
                        <li>At least 8 characters</li>
                        <li>One uppercase letter (A–Z)</li>
                        <li>One lowercase letter (a–z)</li>
                        <li>One digit (0–9)</li>
                    </ul>
                </div>
                <button class="lc-btn lc-btn-primary lc-w-100" type="submit">Set new password</button>
            </form>
            <div class="lc-login-links" style="margin-top:18px;">
                <a asp-action="ForgotPassword">Request a new link</a>
                <a asp-action="Login">Sign in</a>
            </div>
        </div>
    </div>
</div>
