@{ ViewData["Title"] = "Forgot Password"; }
<div class="lc-auth-simple">
    <div style="width:min(460px,calc(100% - 40px))">
        <div class="lc-brand" style="justify-content:center;margin-bottom:32px;">
            <img src="~/logo/LIO.jpeg" alt="LIOS Care" class="lc-logo" />
            <span><strong>LIOS Care</strong><small>Doctor workspace</small></span>
        </div>
        <div class="lc-login-card">
            @if (ViewBag.Sent == true)
            {
                <div style="text-align:center;">
                    <div style="width:72px;height:72px;border-radius:22px;background:#f0fdf4;display:grid;place-items:center;margin:0 auto 20px;font-size:32px;color:#16a34a;">
                        <i class="bi bi-envelope-check"></i>
                    </div>
                    <h2 style="margin:0 0 10px;">Check your inbox</h2>
                    <p style="color:var(--lc-text-2);margin-bottom:24px;">If this email is registered to a LIOS Care doctor account, reset instructions have been sent. Check your spam folder if it doesn't arrive.</p>
                    <a asp-action="Login" class="lc-btn lc-btn-primary lc-w-100">Back to sign in</a>
                </div>
            }
            else
            {
                <h2 style="margin:0 0 6px;">Reset your password</h2>
                <p style="color:var(--lc-text-2);margin-bottom:20px;">Enter your doctor login email address. If an account exists, reset instructions will be sent.</p>
                <form method="post" onsubmit="this.querySelector('button[type=submit]').disabled=true;this.querySelector('button[type=submit]').textContent='Sending…'">
                    @Html.AntiForgeryToken()
                    <label>Email address</label>
                    <input name="email" type="email" placeholder="doctor@example.com" autocomplete="email" required />
                    <button class="lc-btn lc-btn-primary lc-w-100" type="submit" style="margin-top:6px;">Send reset link</button>
                </form>
                <div class="lc-login-links" style="margin-top:18px;">
                    <a asp-action="Login"><i class="bi bi-arrow-left"></i> Back to sign in</a>
                </div>
            }
        </div>
    </div>
</div>
