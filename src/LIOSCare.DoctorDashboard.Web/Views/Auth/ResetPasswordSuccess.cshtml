@{ ViewData["Title"] = "Password Reset Complete"; }
<div class="lc-auth-simple">
    <div style="width:min(460px,calc(100% - 40px))">
        <div class="lc-brand" style="justify-content:center;margin-bottom:32px;">
            <img src="~/logo/LIO.jpeg" alt="LIOS Care" class="lc-logo" />
            <span><strong>LIOS Care</strong><small>Doctor workspace</small></span>
        </div>
        <div class="lc-login-card" style="text-align:center;">
            <div style="width:72px;height:72px;border-radius:22px;background:#f0fdf4;display:grid;place-items:center;margin:0 auto 20px;font-size:32px;color:#16a34a;">
                <i class="bi bi-shield-check"></i>
            </div>
            <h2 style="margin:0 0 10px;">Password updated</h2>
            <p style="color:var(--lc-text-2);margin-bottom:24px;">Your password has been changed successfully. All existing sessions have been signed out for your security.</p>
            <a asp-action="Login" class="lc-btn lc-btn-primary lc-w-100">Sign in with new password</a>
            <div class="lc-login-links" style="margin-top:16px;">
                <span style="color:var(--lc-muted);font-size:12px;">LIOS Care · Doctor Dashboard</span>
            </div>
        </div>
    </div>
</div>
