@model DashboardSummaryDto
@{ ViewData["Title"] = "Dashboard"; }
<section class="lc-page-head"><div><span>Doctor workspace</span><h1>Good day, @User.Identity?.Name</h1><p>Quick view of pending work, SLA risk, direct bookings, and latest private care records.</p></div><form method="post" asp-action="Availability" class="lc-availability">@Html.AntiForgeryToken()<span>Availability</span><input type="hidden" name="isAvailable" value="@(Model.IsAvailable ? "false" : "true")"/><button class="lc-switch @(Model.IsAvailable ? "is-on" : "")" type="submit"><i></i></button></form></section>
<partial name="_KpiCards" model="Model.Kpis" />
<div class="lc-grid lc-grid-2-1">
    <section class="lc-card"><header class="lc-card-head"><h2>Care workload</h2><span class="lc-chip">Live priority</span></header><div class="lc-health"><div style="width:@Model.CareLoadPercent%"></div></div><p class="lc-muted">@Model.AttentionNote</p><div class="lc-action-row"><a asp-controller="QuickChats" asp-action="Index" class="lc-btn lc-btn-primary">Review quick chats</a><a asp-controller="Bookings" asp-action="Index" class="lc-btn lc-btn-outline">Open bookings</a></div></section>
    <section class="lc-card"><header class="lc-card-head"><h2>Latest reports</h2><a asp-controller="SessionReports" asp-action="Index">View all</a></header>@foreach(var r in Model.LatestReports){<div class="lc-row"><div><strong>@r.UserFullName</strong><small>Session #@r.SessionNumber · mood @r.MoodBefore → @r.MoodAfter</small></div><span class="lc-badge lc-badge-info">Private</span></div>}</section>
</div>
<div class="lc-grid lc-grid-2">
    <section class="lc-card"><header class="lc-card-head"><h2>SLA watchlist</h2><a asp-controller="QuickChats" asp-action="Index">Queue</a></header>@foreach(var c in Model.RecentQuickChats){<a class="lc-list-link" asp-controller="QuickChats" asp-action="Details" asp-route-id="@c.Id"><div><strong>@c.UserDisplayName</strong><small>@c.TierName · @c.UserMessage</small></div><span class="lc-badge lc-badge-@c.SlaTone">@c.SlaText</span></a>}</section>
    <section class="lc-card"><header class="lc-card-head"><h2>Recent booking requests</h2><a asp-controller="Bookings" asp-action="Index">Bookings</a></header>@foreach(var b in Model.RecentBookings){<a class="lc-list-link" asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id"><div><strong>@b.UserFullName</strong><small>@b.TierName · $@b.AmountUsd · @b.CreatedAt.ToLocalTime().ToString("MMM dd, hh:mm tt")</small></div><span class="lc-badge lc-badge-success">@b.PaymentStatus</span></a>}</section>
</div>
